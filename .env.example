# Set these as Variables on the Railway service (one per line, no trailing comments). Never commit real values.

# Meta System User token (never expires) and the IG user id, both the same values as the project .env
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_USERNAME=imabgold

# from @BotFather
TELEGRAM_BOT_TOKEN=
# from: python3 -m bot.whoami
TELEGRAM_CHAT_ID=

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-opus-5-5
# low / medium / high; medium is plenty for a two-line reply
DRAFT_EFFORT=medium
# web searches the drafter may run per draft (about 1 cent each); 0 disables
WEB_SEARCHES=2

# 1 = post the auto tier (emoji / short reactions) without review. 0 = shadow: those come to Telegram too.
AUTO_POST=1
POLL_SECONDS=600
# digest and the daily sweep run on this clock
TZ=America/Los_Angeles
# hour for the daily digest; -1 disables it (Marcus's choice, /digest works on demand)
DIGEST_HOUR=-1
# every other reel on the account is swept this often; the hot 7 are every POLL_SECONDS
SWEEP_MINUTES=60
SWEEP_HOURS=48
# Railway volume mount path
DATA_DIR=/data
